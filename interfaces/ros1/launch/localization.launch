<launch>
  <!-- params.yaml 为基础配置；params_localization.yaml 选择纯稠密重定位。 -->
  <arg name="sensor_config" default="/home/zsq/slam/bievr-slam/src/BIEVR-LIO/config/sensor_configs/tzb.yaml"/>
  <arg name="base_params" default="/home/zsq/slam/bievr-slam/src/BIEVR-LIO/config/params.yaml"/>
  <arg name="params" default="/home/zsq/slam/bievr-slam/src/BIEVR-LIO/config/params_localization.yaml"/>
  <arg name="rviz" default="true"/>

  <node pkg="bievr_lio_ros" type="process_topics" name="bievr_lio_localization_node" output="screen"
        args="$(eval '--sensor_config_file ' + (arg('sensor_config') if arg('sensor_config').startswith('/') else find('bievr_lio_ros') + '/../../config/sensor_configs/' + arg('sensor_config') + '.yaml') + ' --params_file ' + arg('base_params') + ' --params_file ' + (arg('params') if arg('params').startswith('/') else find('bievr_lio_ros') + '/../../config/' + arg('params') + '.yaml'))"/>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find bievr_lio_ros)/rviz/localization.rviz"/>
  </group>
</launch>
