<launch>
  <!-- 点云重定位 -->
  <arg name="rviz" default="true"/>

  <node pkg="bievr_lio_ros"
      type="process_topics"
      name="bievr_lio_localization_node"
      output="screen"
      args="--sensor_config_file $(find bievr_lio_ros)/../../config/sensor_configs/tzb.yaml
            --params_file $(find bievr_lio_ros)/../../config/params.yaml
            --params_file $(find bievr_lio_ros)/../../config/params_localization.yaml"/>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find bievr_lio_ros)/rviz/localization.rviz"/>
  </group>
</launch>
