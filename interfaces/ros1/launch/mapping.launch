<launch>
  <arg name="sensor_config"/>
  <arg name="params" default="params"/>
  <arg name="bundle" default="bievr_map_bundle"/>
  <arg name="rviz" default="false"/>

  <node pkg="bievr_lio_ros" type="process_topics" name="bievr_lio_mapping_node" output="screen"
        args="$(eval '--sensor_config_file ' + (arg('sensor_config') if arg('sensor_config').startswith('/') else find('bievr_lio_ros') + '/../../config/sensor_configs/' + arg('sensor_config') + '.yaml') + ' --params_file ' + (arg('params') if arg('params').startswith('/') else find('bievr_lio_ros') + '/../../config/' + arg('params') + '.yaml'))">
    <param name="loop_closure_enable" value="true"/>
    <param name="localization_enable" value="false"/>
    <param name="bundle_path" value="$(arg bundle)"/>
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find bievr_lio_ros)/rviz/config.rviz"/>
  </group>
</launch>
