<launch>
  <!-- GNSS 因子图优化；算法参数统一在 config/gnss_optimize.yaml 中配置。 -->
  <arg name="scans" default="" />
  <arg name="poles_directory" default="" />
  <arg name="pole_params_file" default="" />
  <arg name="skip_poles" default="false" />
  <arg name="skip_output_map" default="false" />
  <arg name="gnss_enu" default="" />
  <arg name="lio_trajectory" />
  <arg name="output_directory" default="$(find bievr_lio_ros)/../../Log/gnss_optimization" />

  <node pkg="bievr_lio_ros" type="gnss_optimize" name="bievr_gnss_optimize"
        output="screen">
    <rosparam command="load" file="$(find bievr_lio_ros)/../../config/gnss_optimize.yaml" />
    <param name="scans" value="$(arg scans)" />
    <param name="poles_directory" value="$(arg poles_directory)" />
    <param name="pole_params_file" value="$(arg pole_params_file)" />
    <param name="skip_poles" value="$(arg skip_poles)" />
    <param name="skip_output_map" value="$(arg skip_output_map)" />
    <param name="gnss_enu" value="$(arg gnss_enu)" />
    <param name="lio_trajectory" value="$(arg lio_trajectory)" />
    <param name="output_directory" value="$(arg output_directory)" />
  </node>
</launch>
