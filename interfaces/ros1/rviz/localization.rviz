Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 10
      Plane Cell Count: 30
      Color: 100; 100; 100
      Alpha: 0.35
    - Class: rviz/PointCloud2
      Name: Prior Map
      Enabled: true
      Topic: /bievr_lio/loc/map
      Queue Size: 2
      Style: Points
      Size (Pixels): 2
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 180; 180; 180
      Alpha: 0.65
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: Current Scan
      Enabled: true
      Topic: /bievr_lio/points/coarse
      Queue Size: 5
      Style: Points
      Size (Pixels): 3
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 90; 20
      Alpha: 1
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz/Path
      Name: Localized Path
      Enabled: true
      Topic: /bievr_lio/loc/path
      Queue Size: 5
      Line Style: Lines
      Line Width: 0.2
      Color: 0; 255; 0
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
    - Class: rviz/Odometry
      Name: Localized Pose
      Enabled: true
      Topic: /bievr_lio/loc/odom
      Queue Size: 10
      Keep: 1
      Shape:
        Value: Axes
        Axes Length: 4
        Axes Radius: 0.25
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 1
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
      Theta std deviation: 0.261799
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 180
      Focal Point:
        X: 50
        Y: 0
        Z: 0
      Pitch: 1.05
      Yaw: 3.14
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1500
